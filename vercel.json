{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "faltasi_website/wsgi.py": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.faltasi.com"
        }
      ],
      "destination": "https://faltasi.com/:path*",
      "permanent": true
    }
  ]
}
