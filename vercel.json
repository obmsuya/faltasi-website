{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.faltasi.com"
        }
      ],
      "destination": "https://faltasi.com/:1",
      "permanent": true
    }
  ]
}
